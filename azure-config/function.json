{
  "scriptFile": "../feedback-system-postech-1.0.0-SNAPSHOT-runner.jar",
  "entryPoint": "io.quarkus.azure.functions.resteasy.runtime.Function.run",
  "bindings": [
    {
      "type": "httpTrigger",
      "direction": "in",
      "name": "req",
      "route": "{*path}",
      "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS"],
      "dataType": "binary",
      "authLevel": "anonymous"
    },
    {
      "type": "http",
      "direction": "out",
      "name": "$return"
    }
  ]
}
