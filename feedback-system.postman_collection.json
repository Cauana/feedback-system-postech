	"item": [
		{
			"name": "Criar Feedback (Normal)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Status deve ser PROCESSADO\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.status).to.eql(\"PROCESSADO\");",
							"});",
							"",
							"pm.test(\"Urgencia deve ser false\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.urgencia).to.eql(false);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"descricao\": \"O curso foi muito esclarecedor e didático.\",\n    \"nota\": 5\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/feedbacks",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8080",
					"path": [
						"feedbacks"
					]
				}
			},
			"response": []
		},
