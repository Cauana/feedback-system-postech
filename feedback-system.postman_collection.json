{
	"info": {
		"_postman_id": "feedback-system-collection",
		"name": "Feedback System Postech",
		"description": "Coleção de requisições para testar a API do Sistema de Feedback (Java/Quarkus)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
